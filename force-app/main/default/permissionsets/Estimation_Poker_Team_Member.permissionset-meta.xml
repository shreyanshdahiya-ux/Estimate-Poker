<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Can participate in estimation sessions and view team information. Cannot create rooms or manage members.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <label>Estimation Poker Team Member</label>
    <license>Salesforce</license>

    <!-- Application Visibility -->
    <applicationVisibilities>
        <application>Estimate_Poker</application>
        <visible>true</visible>
    </applicationVisibilities>

    <!-- Apex Class Access -->
    <classAccesses>
        <apexClass>EstimationService</apexClass>
